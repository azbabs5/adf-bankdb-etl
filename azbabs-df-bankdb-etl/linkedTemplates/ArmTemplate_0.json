		{
			"name": "[concat(parameters('factoryName'), '/customertbltransfer-pl')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "This pipeline will transfer data Customer table from local sql server to azure sql database.",
				"activities": [
					{
						"name": "Customertblcopy",
						"description": "Customer table copy",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"queryTimeout": "02:00:00",
								"isolationLevel": "ReadUncommitted",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "localsqlservercustomer_ds",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "azuredbcustomers_ds",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-12-27T03:35:02Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/localsqlservercustomer_ds')]",
				"[concat(variables('factoryId'), '/datasets/azuredbcustomers_ds')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/transactiontbltransfer-pl')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Transaction table parallel execution using 2 copy acivity",
				"activities": [
					{
						"name": "copy_transanction_tbl_1",
						"description": "Copy transaction table",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": {
									"value": "SELECT *\nFROM Transactions\nWHERE TransactionID BETWEEN @{pipeline().parameters.startid_101}\n                        AND @{pipeline().parameters.endid_110}\n",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "localtransactiontbl_ds",
								"type": "DatasetReference",
								"parameters": {
									"startid": {
										"value": "@pipeline().parameters.startid_101",
										"type": "Expression"
									},
									"endid": {
										"value": "@pipeline().parameters.endid_110",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "azuretransactions_ds",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					},
					{
						"name": "copy_transanction_tbl_2",
						"description": "Copy transaction table",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": {
									"value": "SELECT *\nFROM Transactions\nWHERE TransactionID BETWEEN @{pipeline().parameters.startid_111}\n                        AND @{pipeline().parameters.endid_120}\n",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "localtransactiontbl_ds",
								"type": "DatasetReference",
								"parameters": {
									"startid": {
										"value": "@pipeline().parameters.startid_111",
										"type": "Expression"
									},
									"endid": {
										"value": "@pipeline().parameters.endid_120",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "azuretransactions_ds",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"startid_101": {
						"type": "int",
						"defaultValue": 101
					},
					"endid_110": {
						"type": "int",
						"defaultValue": 110
					},
					"startid_111": {
						"type": "int",
						"defaultValue": 111
					},
					"endid_120": {
						"type": "int",
						"defaultValue": 120
					}
				},
				"annotations": [],
				"lastPublishTime": "2025-12-28T05:22:42Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/localtransactiontbl_ds')]",
				"[concat(variables('factoryId'), '/datasets/azuretransactions_ds')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/transactiontbltransferdynamic-pl')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Transaction table transfer dynamic",
				"activities": [
					{
						"name": "transactiontransfercopy_dynamicrange",
						"description": "Transaction table transfer using dynamicrange",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "truncate_transaction_sp",
								"dependencyConditions": [
									"Completed"
								]
