							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_Truncate_Transactions]"
						},
						"linkedServiceName": {
							"referenceName": "AzureSQLserverLS",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-12-28T14:06:36Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/localtransactiontbl_dynamicrange_ds')]",
				"[concat(variables('factoryId'), '/datasets/azuretransactiontbl_dynamicrange_ds')]",
				"[concat(variables('factoryId'), '/linkedServices/AzureSQLserverLS')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/customer_load_one_time')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
