{
	"name": "customertbltransfer-pl",
	"properties": {
		"description": "This pipeline will transfer data Customer table from local sql server to azure sql database.",
		"activities": [
			{
				"name": "Customertblcopy",
				"description": "Customer table copy",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"isolationLevel": "ReadUncommitted",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "localsqlservercustomer_ds",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "azuredbcustomers_ds",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2025-12-27T03:35:02Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}